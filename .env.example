# Jira (required only for `jira-metrics collect` / `jira-metrics fields`)
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_USER=you@example.com
JIRA_TOKEN=
JIRA_PROJECT=DEMO
JIRA_LABELS=
JIRA_TEAM_LABEL=
JIRA_FIELD_STORY_POINTS=customfield_10016
JIRA_FIELD_SPRINT=customfield_10020
JIRA_PAGE_SIZE=100

# Collector runtime
FETCH_INTERVAL_SECONDS=600
LOG_LEVEL=INFO

# Database
DATABASE_URI=postgresql+psycopg
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=metrics
SQLALCHEMY_ECHO=false
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_PRE_PING=true

# debugpy (only used with docker-compose.debug.yml)
DEBUGPY_ENABLE=false
DEBUGPY_WAIT=false
DEBUGPY_PORT=5678
